{
  "version": 2,
  "rewrites": [
    {"source": "/", "destination": "/index.html"},
    {"source": "/admin", "destination": "/admin.html"},
    {"source": "/token", "destination": "/token/index.html"}
  ],
  "headers": [
    {"source": "/api/(.*)", "headers": [{"key": "Cache-Control", "value": "no-store"}]}
  ]
}
