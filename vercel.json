{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"X-Frame-Options","value":"DENY"},{"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"}]}
  ],
  "rewrites": [
    {"source":"/api/:path*","destination":"/api/:path*"},
    {"source":"/session-check","destination":"/api/session-check"},
    {"source":"/health","destination":"/api/health"},
    {"source":"/key","destination":"/api/page-gate?path=key"},
    {"source":"/key.html","destination":"/api/page-gate?path=key.html"},
    {"source":"/check-key","destination":"/api/page-gate?path=check-key"},
    {"source":"/check-key.html","destination":"/api/page-gate?path=check-key.html"}
  ]
}
