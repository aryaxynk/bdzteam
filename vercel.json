{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://bdzteam.vortexvn.workers.dev/api/:path*" },
    { "source": "/session-check", "destination": "https://bdzteam.vortexvn.workers.dev/session-check" },
    { "source": "/health", "destination": "https://bdzteam.vortexvn.workers.dev/health" },
    { "source": "/key", "destination": "https://bdzteam.vortexvn.workers.dev/key" },
    { "source": "/key.html", "destination": "https://bdzteam.vortexvn.workers.dev/key.html" },
    { "source": "/check-key", "destination": "https://bdzteam.vortexvn.workers.dev/check-key" },
    { "source": "/check-key.html", "destination": "https://bdzteam.vortexvn.workers.dev/check-key.html" }
  ]
}
