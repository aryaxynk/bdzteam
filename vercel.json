{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"X-Frame-Options","value":"DENY"},{"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"}]}],
  "rewrites": [
    {"source":"/","destination":"/key.html"},
    {"source":"/index","destination":"/key.html"},
    {"source":"/index/","destination":"/key.html"},
    {"source":"/session-check","destination":"/api/session-check"},
    {"source":"/session-check/","destination":"/api/session-check"},
    {"source":"/health","destination":"/api/health"},
    {"source":"/health/","destination":"/api/health"},
    {"source":"/key","destination":"/key.html"},
    {"source":"/key/","destination":"/key.html"},
    {"source":"/key.html/","destination":"/key.html"},
    {"source":"/key/index.html","destination":"/key.html"},
    {"source":"/get-key","destination":"/key.html"},
    {"source":"/get-key/","destination":"/key.html"},
    {"source":"/get-key.html","destination":"/key.html"},
    {"source":"/get-key.html/","destination":"/key.html"},
    {"source":"/getkey","destination":"/key.html"},
    {"source":"/getkey/","destination":"/key.html"},
    {"source":"/login","destination":"/login.html"},
    {"source":"/login/","destination":"/login.html"},
    {"source":"/login.html/","destination":"/login.html"},
    {"source":"/login/index.html","destination":"/login.html"},
    {"source":"/admin-login","destination":"/login.html"},
    {"source":"/admin-login/","destination":"/login.html"},
    {"source":"/admin","destination":"/admin.html"},
    {"source":"/admin/","destination":"/admin.html"},
    {"source":"/admin.html/","destination":"/admin.html"},
    {"source":"/admin/index.html","destination":"/admin.html"},
    {"source":"/dashboard","destination":"/admin.html"},
    {"source":"/dashboard/","destination":"/admin.html"},
    {"source":"/dashboard.html","destination":"/admin.html"},
    {"source":"/dashboard.html/","destination":"/admin.html"}
  ]
}
